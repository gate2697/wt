# Plesk / Passenger
NODE_ENV=production
# Do not set PORT in Plesk. Passenger supplies it.
PUBLIC_BASE_URL=https://golf-cb.xyz
FRONTEND_URL=https://golf-cb.xyz
COOKIE_SECURE=true
SESSION_SECRET=replace-with-at-least-32-random-characters

# MySQL / MariaDB (copy the exact values from Plesk > Databases)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONNECTION_LIMIT=10

# Discord OAuth
DISCORD_CLIENT_ID=1510907031568252938
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://golf-cb.xyz/auth/discord/callback
DISCORD_OAUTH_SCOPES=identify email guilds.members.read
DISCORD_GUILD_ID=1495608662025048125
DISCORD_REQUIRE_GUILD_MEMBERSHIP=true

# Optional bot token. Sign-in works without it; use numeric role IDs below when omitted.
DISCORD_BOT_TOKEN=
CB_MOD_PERMS=
CB_HMOD_PERMS=
CB_HIGHMOD_PERMS=

# Bot-to-site API
BOT_API_TOKEN=replace-with-at-least-32-random-characters

# Optional War Thunder resolver
PYTHON_BIN=python3
WT_RESOLVER_SCRIPT=scripts/resolve_wt_user.py
WT_RESOLVER_TIMEOUT_MS=15000
ALLOW_UNRESOLVED_BANS=true
STATSHARK_LOOKUP_URL=
STATSHARK_API_TOKEN=

# Optional email notifications
NOTIFY_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
